+    // FFN/전문가 텐서를 아예 만들지 않아 백엔드 버퍼 범위를 줄인다 — Metal은 "닿은
+    // 페이지"가 아니라 버퍼 전체를 wire 하고, 버퍼 범위는 생성된 텐서 오프셋의 min/max
+    // 껍질이기 때문이다(llama-model-loader.cpp:1375). LLAMA_MMAP_GPU_COPY=1 과 함께 써야
+    // 껍질이 아니라 실제 텐서 크기로 버퍼가 잡힌다.
+    //
+    // 기본 OFF: 실제 체크포인트로 검증하지 않았다. 켜면 로드 시 출력되는
+    // "model buffer size" 줄이 파일 크기가 아니라 실사용 바이트여야 한다.
+    static const bool skip_load = llm_fold_env_flag("LLAMA_FOLD_SKIP_LOAD");
+    if (skip_load && llm_fold_skip_tensor(fold_load, tn.bid, tn.tensor)) {
