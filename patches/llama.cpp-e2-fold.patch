# [E2] Expert fold — the code behind §4.1's expert-only fold, §4.5, and Table 3's Metal row.
# Base: local commit a5faf8d8d. Includes the new file src/models/fold.h.
# Env knobs: LLAMA_FOLD_EXPERTS / LLAMA_FOLD_MAP / LLAMA_FOLD_GAMMA[_FILE] /
#            LLAMA_FOLD_SHEXP_LOGICAL / LLAMA_FOLD_NORM_LOGICAL / LLAMA_FOLD_SKIP_LOAD /
#            LLAMA_MMAP_GPU_COPY.  Metal = SKIP_LOAD + MMAP_GPU_COPY + GGML_OP_OFFLOAD_MIN_BATCH.

diff --git a/src/models/fold.h b/src/models/fold.h
new file mode 100644
index 000000000..38fe8c3c8
--- /dev/null
+++ b/src/models/fold.h
@@ -0,0 +1,230 @@
+#pragma once
+
+// [로컬 패치 E2] 전문가 접기(expert fold) — 논리층 -> 물리층 사상, FFN/전문가 텐서 전용.
+//
+//   LLAMA_FOLD_EXPERTS=R  (R >= 2)
+//     연속한 R개 논리층이 한 물리층의 FFN/전문가 가중치를 공유한다. 대표는 각 그룹의
+//     첫 층이므로 물리층은 논리층에서 항상 R-1 이내다 (깊이가 크게 어긋나지 않는다).
+//
+// 믹서(어텐션 또는 gated delta-net)는 절대 접지 않는다 — 논리 인덱스를 그대로 쓴다.
+// 하이브리드 아키텍처에서 이게 안전한 이유가 그것이다: SWA 위상, recurrent 층 위상,
+// 층별 head 수, 층별 RoPE가 전부 학습된 그대로 남는다.
+// 비용도 작다 — Qwen3.5-122B-A10B와 Laguna-S-2.1에서 믹서는 가중치 바이트의 4~5%이고
+// 라우팅 전문가가 91~93%다.
+//
+// 기존 LLAMA_FOLD_K(전 층 순환 접기, llama/laguna 전용)와는 독립이다.
+
+#include "ggml.h"
+#include "llama-arch.h"
+#include "llama-hparams.h"
+
+#include <cstring>
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+struct llm_fold_map {
+    std::vector<int>  wl;              // 논리 -> 물리
+    std::vector<char> repeat;          // 1 = 더 작은 논리층이 이 물리층을 이미 썼다
+    int   n_unique = 0;                // 상주해야 하는 물리 FFN 블록 수
+    int   group    = 1;                // R
+    int   lead     = 0;                // 접지 않는 선행 dense 블록 수
+    float gamma    = 1.0f;             // 반복 사용 층의 FFN 분기 스케일 (전역)
+    std::vector<float> gamma_l;        // 논리층별 γ (LLAMA_FOLD_GAMMA_FILE). 비면 전역값 사용
+    bool  norm_phys  = true;           // false = FFN pre-norm 은 논리층 유지 (H-B 검증용)
+    bool  shexp_phys = true;           // false = 공유 전문가는 논리층 유지 (H-E 검증용)
+    bool  active   = false;            // 항등이 아니면 true
+};
+
+// 매 그래프 생성마다 새로 만든다 (L=48 기준 비용 무시 가능). 정적 상태를 두지 않으므로
+// 한 프로세스에서 여러 모델(드래프트 모델, 아키텍처 테스트)을 열어도 섞이지 않는다.
+// 불리언 환경 노브: 존재만 보면 LLAMA_FOLD_SKIP_LOAD=0 이 "켜짐"이 된다.
+// 부록 A(10)과 같은 함정이므로 값까지 본다. 빈 문자열/0/false/off 는 꺼짐.
+static inline bool llm_fold_env_flag(const char * name) {
+    const char * v = getenv(name);
+    if (v == nullptr || v[0] == '\0') return false;
+    return !(strcmp(v, "0") == 0 || strcmp(v, "false") == 0 || strcmp(v, "off") == 0);
+}
+
+static inline llm_fold_map llm_fold_build(const llama_hparams & hp) {
+    llm_fold_map f;
+
+    const int L = (int) hp.n_layer();
+    GGML_ASSERT(L > 0);
+    f.wl.resize(L);
+    f.repeat.assign(L, 0);
+
+    const char * env = getenv("LLAMA_FOLD_EXPERTS");
+    const int    R   = (env && env[0] != '\0') ? atoi(env) : 0;
+
+    // LLAMA_FOLD_GAMMA=g: 반복 사용되는 논리층의 FFN 분기 출력을 g배 한다.
+    //   g=1 (기본) 감쇠 없음.
+    //   g=0        반복 층이 정확히 항등이 되어, 모델은 "전 층 믹서 + 그룹 대표 층에만 FFN"이
+    //              된다. 붕괴하지 않는 바닥이 보장되므로 g는 0~1 사이의 안전한 다이얼이다.
+    //   g>1        pre-norm RMSNorm이 스케일을 먼저 나눠버리므로 재사용 층은 폭발이 아니라
+    //              자기 감쇠한다. 따라서 g>1도 유효한 탐색 범위다.
+    // 빈 문자열은 "설정 안 함"으로 본다. atof("") == 0.0 이라 그냥 두면
+    // LLAMA_FOLD_GAMMA= (빈 값)이 조용히 gamma=0 이 된다.
+    // H-B / H-E 검증 노브. 기본값은 지금 동작 그대로(물리층).
+    //   LLAMA_FOLD_NORM_LOGICAL=1   FFN pre-norm 을 논리층에서 가져온다
+    //   LLAMA_FOLD_SHEXP_LOGICAL=1  공유 전문가를 논리층에서 가져온다 (전 토큰이 타므로 의심 1순위)
+    f.norm_phys  = !llm_fold_env_flag("LLAMA_FOLD_NORM_LOGICAL");
+    f.shexp_phys = !llm_fold_env_flag("LLAMA_FOLD_SHEXP_LOGICAL");
+
+    if (const char * g = getenv("LLAMA_FOLD_GAMMA")) {
+        if (g[0] != '\0') {
+            f.gamma = (float) atof(g);
+        }
+    }
+
+    // LLAMA_FOLD_GAMMA_FILE=<path>: 논리층당 float 한 줄. 층별 국소 회귀로 맞춘 γ 를 넣는다.
+    if (const char * gf = getenv("LLAMA_FOLD_GAMMA_FILE")) {
+        if (gf[0] != '\0') {
+            FILE * fp = fopen(gf, "r");
+            GGML_ASSERT(fp && "LLAMA_FOLD_GAMMA_FILE 을 열 수 없음");
+            f.gamma_l.assign(L, f.gamma);
+            for (int il = 0; il < L; ++il) {
+                double v;
+                GGML_ASSERT(fscanf(fp, "%lf", &v) == 1 && "gamma 파일의 값 개수가 n_layer 와 다름");
+                f.gamma_l[il] = (float) v;
+            }
+            fclose(fp);
+        }
+    }
+
+    // LLAMA_FOLD_MAP="0,1,1,3,..." — 명시적 사상. 이분탐색·디버깅용.
+    // 길이는 n_layer 와 같아야 하고, 지정되면 R 은 무시된다.
+    if (const char * m = getenv("LLAMA_FOLD_MAP")) {
+        if (m[0] != '\0') {
+            int n = 0;
+            const char * q = m;
+            while (*q && n < L) {
+                f.wl[n++] = atoi(q);
+                while (*q && *q != ',') ++q;
+                if (*q == ',') ++q;
+            }
+            GGML_ASSERT(n == L && "LLAMA_FOLD_MAP 길이가 n_layer 와 다름");
+            std::vector<char> seen0(L, 0);
+            for (int il = 0; il < L; ++il) {
+                const int w = f.wl[il];
+                GGML_ASSERT(w >= 0 && w < L);
+                f.repeat[il] = seen0[w];
+                if (!seen0[w]) { seen0[w] = 1; f.n_unique++; }
+                f.active = f.active || (w != il);
+            }
+            f.group = -1;
+            return f;
+        }
+    }
+
+    if (R < 2) {
+        for (int il = 0; il < L; ++il) {
+            f.wl[il] = il;
+        }
+        f.n_unique = L;
+        return f;                      // 항등 — 비활성일 때 증명 가능한 no-op
+    }
+
+    f.group = R;
+
+    // 선행 dense 블록(laguna: 1, deepseek 계열: 3)은 FFN 구조가 MoE와 다르다.
+    // 접지 않고, MoE 층이 그 위로 사상되지도 않게 한다 — 그렇지 않으면 그 논리층이
+    // 256-전문가 블록 대신 dense FFN을 실행하게 된다.
+    const int lead = (int) hp.n_layer_dense_lead;
+    GGML_ASSERT(lead >= 0 && lead < L);
+    f.lead = lead;
+
+    std::vector<char> seen(L, 0);
+    for (int il = 0; il < L; ++il) {
+        const int w = il < lead ? il                       // dense-lead: 항상 자기 자신
+                                : lead + ((il - lead) / R) * R;  // 그룹의 첫 층
+        GGML_ASSERT(w >= 0 && w < L);
+        GGML_ASSERT((w < lead) == (il < lead) && "dense-lead 경계를 넘는 사상");
+        f.wl[il]     = w;
+        f.repeat[il] = seen[w];
+        if (!seen[w]) {
+            seen[w] = 1;
+            f.n_unique++;
+        }
+        f.active = f.active || (w != il);
+    }
+
+    return f;
+}
+
+// 프로세스당 한 번만 찍는다 (그래프는 ubatch마다 다시 만들어진다).
+static inline void llm_fold_log_once(const llm_fold_map & f, const char * arch) {
+    static bool done = false;
+    if (done || !f.active) {
+        return;
+    }
+    done = true;
+
+    fprintf(stderr, "[E2-FOLD] arch=%s experts_folded R=%d lead=%d unique_ffn=%d/%d gamma=%.3f map=",
+            arch, f.group, f.lead, f.n_unique, (int) f.wl.size(), f.gamma);
+    if (!f.norm_phys)  fprintf(stderr, "[E2-FOLD] ffn pre-norm follows the LOGICAL layer\n");
+    if (!f.shexp_phys) fprintf(stderr, "[E2-FOLD] shared expert follows the LOGICAL layer\n");
+    for (size_t il = 0; il < f.wl.size(); ++il) {
+        fprintf(stderr, "%d%s", f.wl[il], il + 1 < f.wl.size() ? "," : "\n");
+    }
+    fprintf(stderr, "[E2-FOLD] mixer (attn / delta-net) is NOT folded — logical index kept\n");
+}
+
+// 그래프가 wl(물리층)로 읽는 텐서 클래스. qwen35moe.cpp 의 build_layer_ffn 및
+// attn_post_norm 처리와 반드시 일치해야 한다.
+//
+// 로더가 이 목록을 쓰는 이유: Metal은 "닿은 페이지"가 아니라 "버퍼 전체"를 wire 하고,
+// 버퍼 범위는 생성된 텐서 오프셋의 min/max 껍질이다(llama-model-loader.cpp:1375).
+// 믹서를 전 층 남기면 껍질이 파일 전체라 접기 효과가 0이 된다. 접혀서 안 쓰이는
+// 텐서를 아예 만들지 않아야 버퍼가 줄어든다 (LLAMA_MMAP_GPU_COPY=1 과 함께).
+static inline bool llm_fold_is_folded_tensor(llm_tensor t) {
+    switch (t) {
+        case LLM_TENSOR_FFN_GATE_INP:
+        case LLM_TENSOR_FFN_GATE_INP_SHEXP:
+        case LLM_TENSOR_FFN_DOWN_EXPS:
+        case LLM_TENSOR_FFN_GATE_EXPS:
+        case LLM_TENSOR_FFN_UP_EXPS:
+        case LLM_TENSOR_FFN_GATE_UP_EXPS:
+        case LLM_TENSOR_FFN_DOWN_SHEXP:
+        case LLM_TENSOR_FFN_GATE_SHEXP:
+        case LLM_TENSOR_FFN_UP_SHEXP:
+        case LLM_TENSOR_FFN_EXP_PROBS_B:
+        case LLM_TENSOR_ATTN_POST_NORM:   // qwen35moe: FFN 그룹의 pre-norm
+            return true;
+        default:
+            return false;
+    }
+}
+
+// 논리층 il 의 이 텐서 클래스가 그래프에서 절대 참조되지 않는가?
+static inline bool llm_fold_is_shexp_tensor(llm_tensor t) {
+    switch (t) {
+        case LLM_TENSOR_FFN_DOWN_SHEXP:
+        case LLM_TENSOR_FFN_GATE_SHEXP:
+        case LLM_TENSOR_FFN_UP_SHEXP:
+        case LLM_TENSOR_FFN_GATE_INP_SHEXP:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static inline bool llm_fold_skip_tensor(const llm_fold_map & f, int bid, llm_tensor t) {
+    if (!f.active || bid < 0 || bid >= (int) f.repeat.size()) {
+        return false;   // MTP/nextn 블록(bid == n_layer)은 여기서 걸러진다
+    }
+    if (!f.repeat[bid] || !llm_fold_is_folded_tensor(t)) {
+        return false;
+    }
+    // 공유 전문가가 논리층을 따라가면(LLAMA_FOLD_SHEXP_LOGICAL) 모든 층에서 필요하다.
+    // 이걸 빼먹으면 그래프가 만들어지지 않은 텐서를 참조한다.
+    if (!f.shexp_phys && llm_fold_is_shexp_tensor(t)) {
+        return false;
+    }
+    // 마찬가지로 pre-norm 이 논리층을 따라가면 건너뛰면 안 된다.
+    if (!f.norm_phys && t == LLM_TENSOR_ATTN_POST_NORM) {
+        return false;
+    }
+    return true;
+}
