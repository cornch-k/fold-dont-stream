@@ -0,0 +1,52 @@
+#!/usr/bin/env bash
+# Shared config and helpers for the M1 Max Qwen3.5-122B-A10B MoE benchmark harness.
+# Sourced by the other scripts. Editing values here changes the whole matrix.
+#
+# Nothing here runs the model. matrix.sh is guarded and only runs on RUN=1.
+
+set -u
+
+ROOT="/Users/angigyeom/Desktop/optillama/llama.cpp"
+BIN="${ROOT}/build-m1max/bin"
+export DYLD_LIBRARY_PATH="${BIN}:${DYLD_LIBRARY_PATH:-}"
+MODEL="/Users/angigyeom/Desktop/optillama/models/Qwen3.5-122B-A10B-MTP-GGUF/UD-Q4_K_XL/Qwen3.5-122B-A10B-UD-Q4_K_XL-00001-of-00003.gguf"
+RESULTS="${ROOT}/scripts/m1max-moe/results"
+
+# Common runtime parameters (tune here).
+CTX=8192            # target context length for the stability goal
+NGEN=128            # tokens to generate in the cli timing run
+THREADS=8           # M1 Max has 8 performance cores
+FA="on"             # flash attention: on|off|auto
+KV_K="f16"          # baseline K cache type (matrix.sh overrides for the kv-quant row)
+KV_V="f16"          # baseline V cache type
+MON_INTERVAL="0.5"  # memory sampler interval, seconds
+
+# A fixed, reproducible prompt. Kept short so prefill is not the dominant cost in
+# the throughput rows; the long-context stability check builds its own prompt.
+PROMPT='Explain, step by step, how a mixture-of-experts transformer routes tokens to experts, and why sparse activation reduces compute per token. Then give three concrete tradeoffs.'
+
+mkdir -p "${RESULTS}"
+
+# require the model and binaries to exist before any run
+harness_preflight() {
+    local ok=1
+    [ -f "${MODEL}" ] || { echo "MISSING model: ${MODEL}" >&2; ok=0; }
+    [ -x "${BIN}/llama-cli" ] || { echo "MISSING ${BIN}/llama-cli" >&2; ok=0; }
+    [ -x "${BIN}/llama-bench" ] || { echo "MISSING ${BIN}/llama-bench" >&2; ok=0; }
+    [ "${ok}" = "1" ] || return 1
+}
+
+# one-time system snapshot for the results header
+sysinfo_dump() {
+    {
+        echo "# sysinfo $(date '+%Y-%m-%d %H:%M:%S')"
+        echo "hw.model: $(sysctl -n hw.model 2>/dev/null)"
+        echo "memsize:  $(sysctl -n hw.memsize 2>/dev/null)"
+        echo "os:       $(sw_vers -productVersion 2>/dev/null) / $(uname -r)"
+        echo "model:    ${MODEL}"
+        echo "cli:      ${BIN}/llama-cli"
+        echo "git head: $(cd "${ROOT}" && git rev-parse --short HEAD 2>/dev/null)"
+        echo "swap:     $(sysctl -n vm.swapusage 2>/dev/null)"
+    } > "${RESULTS}/sysinfo.txt"
+    cat "${RESULTS}/sysinfo.txt"
+}
diff --git a/scripts/m1max-moe/expert_ranges.py b/scripts/m1max-moe/expert_ranges.py
new file mode 100644
index 000000000..44f764e29
--- /dev/null
+++ b/scripts/m1max-moe/expert_ranges.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+# Emit "offset length" byte ranges (stdout) of the hottest routed-expert slices
+# of a GGUF, ranked by a GGML_MOE_STATS routing CSV, until a byte budget is
+# reached. Feed the output to pin_ranges (mlock) or use it for analysis.
+#
+#   python3 expert_ranges.py --gguf model.gguf --stats moe_stats.csv \
+#       --budget-mb 6144 > pin.txt
+#   ./pin_ranges model.gguf pin.txt
+
+import argparse
+import csv
+import re
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "gguf-py"))
+
+from gguf import GGUFReader
+
+EXPS_RE = re.compile(r"^blk\.(\d+)\.ffn_(gate|up|down)_exps\.weight$")
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--gguf", required=True)
+    ap.add_argument("--stats", help="routing CSV; required unless --non-expert")
+    ap.add_argument("--budget-mb", type=int, default=6144)
+    ap.add_argument("--expert-count", type=int,
+                    help="override for split shards without arch metadata")
+    ap.add_argument("--non-expert", action="store_true",
+                    help="emit ranges of every non-routed-expert tensor instead "
+                         "(the always-hot attention/shared/embedding set)")
+    args = ap.parse_args()
+
+    if args.non_expert:
+        reader = GGUFReader(args.gguf)
+        total = 0
+        for t in reader.tensors:
+            if EXPS_RE.match(t.name):
+                continue
+            print(f"{int(t.data_offset)} {int(t.n_bytes)}")
+            total += int(t.n_bytes)
+        print(f"# non-expert set: {total/2**20:.0f} MiB", file=sys.stderr)
+        return
+    if not args.stats:
+        sys.exit("error: --stats is required unless --non-expert")
+
+    # total routed rows per (layer, expert), summed over gate/up/down
+    hot: dict[tuple[int, int], int] = {}
+    with open(args.stats, newline="") as f:
+        for row in csv.DictReader(f):
+            m = EXPS_RE.match(row["tensor"])
+            if m:
+                key = (int(m.group(1)), int(row["expert"]))
+                hot[key] = hot.get(key, 0) + int(row["rows"])
+
+    reader = GGUFReader(args.gguf)
+    if args.expert_count:
+        # split-GGUF shards 2..N carry no architecture metadata
+        n_expert = args.expert_count
+    else:
+        n_expert = reader.get_field(
+            f"{reader.get_field('general.architecture').contents()}.expert_count").contents()
+
+    # per-expert slice location within each exps tensor
+    slices: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for t in reader.tensors:
+        m = EXPS_RE.match(t.name)
+        if not m:
+            continue
+        layer = int(m.group(1))
+        per_expert = int(t.n_bytes) // n_expert
+        for e in range(n_expert):
+            slices.setdefault((layer, e), []).append(
+                (int(t.data_offset) + e * per_expert, per_expert))
+
+    budget = args.budget_mb * 2**20
+    used = 0
+    picked = 0
+    for (layer, e), _rows in sorted(hot.items(), key=lambda kv: -kv[1]):
+        ranges = slices.get((layer, e))
+        if not ranges:
+            continue
+        size = sum(l for _, l in ranges)
+        if used + size > budget:
+            break
+        for off, length in ranges:
+            print(f"{off} {length}")
+        used += size
+        picked += 1
+    print(f"# {picked} experts, {used/2**20:.0f} MiB of {args.budget_mb} MiB budget",
+          file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
