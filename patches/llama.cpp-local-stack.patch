@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+# Phase-1 matrix for Qwen3.5-122B-A10B UD-Q4_K_XL on the 32 GB M1 Max.
+# Runs the cold CPU baseline and the Metal-hybrid re-evaluation, then AHEAD
+# sweep rows. Sequential, one process at a time, swap-delta guarded.
+#
+# usage: RUN=1 ./bench_m1max_q4.sh [rows]
+#   rows: comma list among r1,r2,r3 (default r1,r2)
+
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+. "${HERE}/common.sh"
+
+[ "${RUN:-0}" = "1" ] || { echo "guard: set RUN=1 to execute"; exit 1; }
+ROWS="${1:-r1,r2}"
+
+SWAP0=$(sysctl -n vm.swapusage | awk '{print $6}' | tr -d 'M')
+swap_guard() {
+    local now delta
+    now=$(sysctl -n vm.swapusage | awk '{print $6}' | tr -d 'M')
+    delta=$(printf '%.0f' "$(echo "${now} - ${SWAP0}" | bc)")
+    if [ "${delta}" -gt 3072 ]; then
+        echo "!! swap delta ${delta}MB > 3GB — aborting matrix" >&2
+        exit 2
+    fi
+}
+
+dup_guard() {
+    if pgrep -f "llama-cli|llama-bench" >/dev/null 2>&1; then
+        echo "!! stray llama process running — aborting" >&2; exit 3
+    fi
+}
+
+run_row() {
+    local label="$1"; shift
+    dup_guard
+    echo "=== row ${label} $(date '+%H:%M:%S') ==="
+    env "$@" "${HERE}/smoke.sh" 64 4096 | tee "${RESULTS}/row.${label}.txt"
+    swap_guard
+}
+
+# -nr on every row guards against the ARM repack anonymous-allocation blowup
+# on Q4 (measured swap incident on 07-22).
+case ",${ROWS}," in *,r1,*)
+    # R1: cold-ish CPU baseline, experts mmap-lazy
+    run_row r1-cpu-e8 GGML_MOE_PREFETCH=1 LLAMA_MMAP_NO_PREFETCH=1 GGML_MOE_PREFETCH_AHEAD=3 \
+        NGL=0 T=8 EXTRA="-nr"
+;; esac
+case ",${ROWS}," in *,r2,*)
+    # R2: Metal hybrid — non-expert tensors copied to GPU (~8 GiB), experts stay
+    # CPU mmap. 16 GB verdict (cache eviction) does not carry over to 32 GB.
+    run_row r2-hybrid-e8 GGML_MOE_PREFETCH=1 LLAMA_MMAP_NO_PREFETCH=1 GGML_MOE_PREFETCH_AHEAD=3 \
+        LLAMA_MMAP_GPU_COPY=1 NGL=999 NCMOE=99 T=8 EXTRA="-nr"
+;; esac
+case ",${ROWS}," in *,r3,*)
+    # R3: lookahead depth sweep on the CPU path
+    for A in 0 2 6; do
+        run_row "r3-ahead${A}" GGML_MOE_PREFETCH=1 LLAMA_MMAP_NO_PREFETCH=1 GGML_MOE_PREFETCH_AHEAD=${A} \
+            NGL=0 T=8 EXTRA="-nr"
+    done
+;; esac
+
+echo "=== matrix done $(date '+%H:%M:%S') ==="
