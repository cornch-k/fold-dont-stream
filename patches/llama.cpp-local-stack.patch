+. "${HERE}/common.sh"
+
+WIKI="${WIKI:?path to wiki.test.raw}"
+CHUNKS="${CHUNKS:-8}"
+IQ2M="/Users/angigyeom/optillama-models/Qwen3.5-122B-A10B-UD-IQ2_M.gguf"
+
+for n in 6 4; do
+    log="${RESULTS}/ppl.iq2m_e${n}.log"
+    echo ">>> ppl iq2m_e${n}"
+    GGML_MOE_PREFETCH=1 LLAMA_MMAP_NO_PREFETCH=1 \
+    "${BIN}/llama-perplexity" -m "${IQ2M}" -f "${WIKI}" --chunks "${CHUNKS}" \
+        -t 4 -ngl 0 -fa on -c 2048 -b 2048 \
