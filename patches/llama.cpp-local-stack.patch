+#!/usr/bin/env bash
+# Clean pp/tg throughput cross-check via llama-bench (JSON out). GUARDED by RUN=1.
+# llama-bench does its own warmup (which for this model touches all experts), so
+# treat these numbers as steady-state throughput, and use run_one.sh/matrix.sh
+# for the load-time, TTFT, and memory/paging story.
+#
+#   RUN=1 ./bench_throughput.sh
+#
+# Note: GGML_METAL_NO_RESIDENCY and -ncmoe are the two levers swept here.
+
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+. "${HERE}/common.sh"
+
+if [ "${RUN:-0}" != "1" ]; then
+    echo "guarded: set RUN=1 to execute. Sweeps: {residency off/on} x {ncmoe 0,24,49}."
+    echo "  clean throughput only (pp=${PROMPT:+512}/tg=128). memory story is in matrix.sh."
+    exit 0
+fi
+harness_preflight || exit 1
+
+out="${RESULTS}/bench_throughput.$(date '+%Y%m%d-%H%M%S').jsonl"
+run_bench() { # env-label ncmoe residency
+    local tag="$1" ncmoe="$2" resid="$3"
+    local pfx=(); [ "${resid}" = "off" ] && pfx=(env GGML_METAL_NO_RESIDENCY=1)
+    echo ">>> bench ${tag}: ncmoe=${ncmoe} residency=${resid}"
+    "${pfx[@]}" "${BIN}/llama-bench" -m "${MODEL}" \
+        -p 512 -n 128 -r 3 -ngl 999 -fa "${FA}" -t "${THREADS}" \
+        -ctk "${KV_K}" -ctv "${KV_V}" -mmp 1 -ncmoe "${ncmoe}" \
+        -o jsonl >> "${out}" 2>>"${out%.jsonl}.err"
+}
+
+run_bench A_noresid_ncmoe0  0  off
+run_bench B_ncmoe24         24 on
+run_bench B_ncmoe49         49 on
+
+echo "=== bench done: ${out} ==="
