+// enqueue an async fill for (base, expert); mutex held by caller
+static void ggml_moe_cache_enqueue_locked(const void * base, int expert, size_t size) {
+    int next = (g_moe_cache.q_tail + 1) % MOE_CACHE_QUEUE_SZ;
+    if (next == g_moe_cache.q_head) {
+        g_moe_cache.drops++;
+        return;
+    }
+    g_moe_cache.queue[g_moe_cache.q_tail].base   = base;
+    g_moe_cache.queue[g_moe_cache.q_tail].expert = expert;
+    g_moe_cache.queue[g_moe_cache.q_tail].size   = size;
+    g_moe_cache.q_tail = next;
+    if (!g_moe_cache.worker_up) {
+        pthread_t tid;
+        if (pthread_create(&tid, NULL, ggml_moe_cache_worker, NULL) == 0) {
+            pthread_detach(tid);
+            g_moe_cache.worker_up = 1;
+        }
+    }
+    pthread_cond_signal(&g_moe_cache.cv);
+}
