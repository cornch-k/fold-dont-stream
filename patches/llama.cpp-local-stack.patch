+printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
+    "${label}" "${residency}" "${warmup}" "${ncmoe}" "${kvk}/${kvv}" \
+    "${load_ms:-NA}" "${pp_tps:-NA}" "${tg_tps:-NA}" \
+    "${peak_rss:-NA}" "${peak_wired:-NA}" "${max_swap:-NA}" "${swapins_delta:-NA}" "${rc}" \
+    | tee -a "${summary}"
+echo ""
diff --git a/scripts/m1max-moe/smoke.sh b/scripts/m1max-moe/smoke.sh
new file mode 100755
index 000000000..9d09029e8
--- /dev/null
+++ b/scripts/m1max-moe/smoke.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+# Minimal first-light run on the 16 GB M1 mini: all routed experts on CPU
+# (mmap, lazy), attention/shared on Metal, no warmup. Short generation so a
+# thrashing config surfaces quickly without hanging the session.
+#
+# usage: smoke.sh [ngen] [ctx]
+
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+. "${HERE}/common.sh"
+
+NGEN_S="${1:-32}"
+CTX_S="${2:-4096}"
+MODEL="${MODEL_OVERRIDE:-${MODEL}}"
+THREADS="${T:-${THREADS}}"
+
+stamp="$(date '+%Y%m%d-%H%M%S')"
+raw="${RESULTS}/smoke.${stamp}.log"
+mon="${RESULTS}/smoke.${stamp}.mon.csv"
+
+args=( -m "${MODEL}" -c "${CTX_S}" -n "${NGEN_S}" -t "${THREADS}"
+       -fa on -ngl "${NGL:-999}" -ncmoe "${NCMOE:-99}" --no-warmup ${OPOFF:---no-op-offload}
+       -b 512 -ub 512
+       -no-cnv -st --seed 42 -p "${PROMPT}" ${EXTRA:-} )
+
+echo ">>> smoke: ngen=${NGEN_S} ctx=${CTX_S}" | tee "${raw}"
+"${BIN}/llama-cli" "${args[@]}" >>"${raw}" 2>&1 </dev/null &
+pid=$!
+# both spawns must not inherit our stdout: a held pipe blocks the caller's tee
+# until the watchdog sleep expires, long after llama-cli has exited
+"${HERE}/monitor.sh" "${pid}" "${mon}" "1" >/dev/null 2>&1 &
+monpid=$!
+( sleep "${MAX_SECONDS:-2400}"; kill -0 "${pid}" 2>/dev/null && { echo "WATCHDOG kill" >>"${raw}"; kill -TERM "${pid}" 2>/dev/null; } ) >/dev/null 2>&1 &
+wdpid=$!
+
+wait "${pid}"; rc=$?
+kill "${monpid}" "${wdpid}" 2>/dev/null; wait 2>/dev/null
+
+echo "=== rc=${rc} ==="
+echo "--- perf tail ---"
+grep -E "load time|eval time|sampl|total time" "${raw}" | tail -8
+echo "--- mem peaks ---"
+awk -F, 'NR>1{if($2>r)r=$2; if($3>w)w=$3; if($6>s)s=$6} END{printf "peakRSS=%d MB peakWired=%d MB peakSwap=%d MB\n", r, w, s}' "${mon}"
+echo "raw: ${raw}"
