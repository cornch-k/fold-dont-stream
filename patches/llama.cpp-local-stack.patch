--- /dev/null
+++ b/scripts/m1max-moe/ppl_matrix.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Sequential perplexity comparison over quant/expert-count configs.
+# Small chunk count: absolute PPL is not comparable to published numbers,
+# only the relative deltas between rows matter.
+
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+. "${HERE}/common.sh"
+
+WIKI="${WIKI:?path to wiki.test.raw}"
+CHUNKS="${CHUNKS:-8}"
+OUT="${RESULTS}/ppl.$(date '+%Y%m%d-%H%M%S').tsv"
+
+IQ2M="/Users/angigyeom/optillama-models/Qwen3.5-122B-A10B-UD-IQ2_M.gguf"
+Q2K="/Users/angigyeom/optillama-models/Qwen3.5-122B-A10B-expQ2K.gguf"
+
+run_ppl() { # label model extra...
+    local label="$1" model="$2"; shift 2
+    local log="${RESULTS}/ppl.${label}.log"
+    echo ">>> ppl ${label}"
+    GGML_MOE_PREFETCH=1 LLAMA_MMAP_NO_PREFETCH=1 \
+    "${BIN}/llama-perplexity" -m "${model}" -f "${WIKI}" --chunks "${CHUNKS}" \
+        -t 4 -ngl 0 -fa on -c 2048 -b 2048 "$@" </dev/null >"${log}" 2>&1
+    local ppl
+    ppl="$(grep -aoE 'Final estimate: PPL = [0-9.]+ \+/- [0-9.]+' "${log}" | tail -1)"
+    printf '%s\t%s\n' "${label}" "${ppl:-FAILED(see ${log})}" | tee -a "${OUT}"
+}
+
+run_ppl iq2m_e8 "${IQ2M}"
+run_ppl q2k_e8  "${Q2K}"
+run_ppl q2k_e6  "${Q2K}" --override-kv qwen35moe.expert_used_count=int:6
+run_ppl q2k_e4  "${Q2K}" --override-kv qwen35moe.expert_used_count=int:4
+echo "done: ${OUT}"
diff --git a/scripts/m1max-moe/prune_experts.py b/scripts/m1max-moe/prune_experts.py
new file mode 100644
index 000000000..f899c93bb
--- /dev/null
+++ b/scripts/m1max-moe/prune_experts.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+# Prune MoE routed experts from a GGUF without dequantizing.
+#
+# The routed-expert tensors (ffn_{gate,up,down}_exps) store the expert dimension
+# as the slowest-varying axis, so each expert is one contiguous byte slice and a
+# subset can be copied bit-exact for any quantization type. The router weight
+# (ffn_gate_inp) stores one contiguous row per expert and is sliced the same
+# way. {arch}.expert_count is rewritten to the kept count.
+#
+# Expert ranking comes from a routing-stats CSV produced by the local
+# GGML_MOE_STATS=<path> patch (columns: tensor,expert,rows) or from an explicit
+# JSON keep-list {"<layer>": [expert ids...]}. Layers absent from the ranking
+# fall back to experts [0..K-1] with a warning (e.g. an unused MTP layer).
+#
+# Usage:
+#   python3 prune_experts.py --src in.gguf --dst out.gguf --keep 64 \
+#       --stats moe_stats.csv [--dry-run]
+#   python3 prune_experts.py --src in.gguf --dst out.gguf --keep-list keep.json
+
+import argparse
+import csv
+import json
+import re
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "gguf-py"))
+
+import numpy as np
+import gguf
+from gguf import GGUFReader, GGUFWriter, GGUFValueType
+
+EXPS_RE = re.compile(r"^blk\.(\d+)\.ffn_(gate|up|down)_exps\.weight$")
+ROUTER_RE = re.compile(r"^blk\.(\d+)\.ffn_gate_inp\.weight$")
+
+# virtual fields the writer regenerates itself
+SKIP_KEYS = {"GGUF.version", "GGUF.tensor_count", "GGUF.kv_count"}
+
+
+def load_ranking_from_stats(path: str) -> dict[int, list[int]]:
+    # rank experts per layer by total routed rows summed over gate/up/down
+    totals: dict[int, dict[int, int]] = defaultdict(lambda: defaultdict(int))
+    with open(path, newline="") as f:
+        for row in csv.DictReader(f):
+            m = EXPS_RE.match(row["tensor"])
+            if not m:
+                continue
+            totals[int(m.group(1))][int(row["expert"])] += int(row["rows"])
+    return {
+        layer: [e for e, _ in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))]
+        for layer, counts in totals.items()
+    }
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--src", required=True)
+    ap.add_argument("--dst", required=True)
+    ap.add_argument("--keep", type=int, help="number of experts to keep per layer")
+    ap.add_argument("--stats", help="routing stats CSV from GGML_MOE_STATS")
+    ap.add_argument("--keep-list", help="JSON {layer: [expert ids]} overriding --stats")
+    ap.add_argument("--dry-run", action="store_true")
+    args = ap.parse_args()
+
+    reader = GGUFReader(args.src)
+
+    arch = reader.get_field("general.architecture").contents()
+    n_expert = reader.get_field(f"{arch}.expert_count").contents()
+    n_expert_used = reader.get_field(f"{arch}.expert_used_count").contents()
+
+    keep_lists: dict[int, list[int]] = {}
+    if args.keep_list:
+        with open(args.keep_list) as f:
+            keep_lists = {int(k): sorted(v) for k, v in json.load(f).items()}
+        keep_n = {len(v) for v in keep_lists.values()}
+        if len(keep_n) != 1:
+            sys.exit("error: keep-list layers keep differing expert counts")
+        keep = keep_n.pop()
+    else:
+        if not args.keep:
+            sys.exit("error: --keep is required unless --keep-list is given")
+        keep = args.keep
+        ranking = load_ranking_from_stats(args.stats) if args.stats else {}
+        for layer, ranked in ranking.items():
+            if len(ranked) < keep:
+                sys.exit(f"error: layer {layer} has stats for only {len(ranked)} experts")
+            keep_lists[layer] = sorted(ranked[:keep])
+
+    if keep >= n_expert:
+        sys.exit(f"error: keep={keep} >= current expert_count={n_expert}")
+    if keep < n_expert_used:
+        sys.exit(f"error: keep={keep} < expert_used_count={n_expert_used}")
+
+    # plan the tensor transforms
+    plan = []  # (tensor, keep_list or None)
+    warned_layers = set()
+    total_in = total_out = 0
+    for t in reader.tensors:
+        m = EXPS_RE.match(t.name) or ROUTER_RE.match(t.name)
+        keep_list = None
+        if m:
+            layer = int(m.group(1))
+            if layer not in keep_lists:
+                if layer not in warned_layers:
+                    print(f"warning: no ranking for layer {layer}; keeping experts 0..{keep-1}")
+                    warned_layers.add(layer)
+                keep_lists[layer] = list(range(keep))
+            keep_list = keep_lists[layer]
+            if int(t.shape[-1]) != n_expert:
+                sys.exit(f"error: {t.name} last dim {t.shape[-1]} != expert_count {n_expert}")
+        elif int(t.shape[-1]) == n_expert and ".ffn_" in t.name and "_shexp" not in t.name:
+            sys.exit(f"error: unexpected expert-shaped tensor {t.name}; extend the tool")
+        nbytes = int(t.n_bytes)
+        total_in += nbytes
+        total_out += nbytes if keep_list is None else nbytes * keep // n_expert
+        plan.append((t, keep_list))
+
+    print(f"arch={arch} expert_count {n_expert} -> {keep} (used {n_expert_used})")
+    print(f"size {total_in/2**30:.2f} GiB -> {total_out/2**30:.2f} GiB")
+    if args.dry_run:
+        for t, kl in plan:
+            if kl is not None:
+                print(f"  slice {t.name} {list(t.shape)} keep={kl[:8]}{'...' if len(kl) > 8 else ''}")
+        return
+
+    writer = GGUFWriter(args.dst, arch)
+    for field in reader.fields.values():
+        if field.name in SKIP_KEYS or field.name == "general.architecture":
+            continue
+        val = field.contents()
+        if field.name == f"{arch}.expert_count":
+            val = keep
+        vtype = field.types[0]
+        sub_type = field.types[-1] if vtype == GGUFValueType.ARRAY else None
+        writer.add_key_value(field.name, val, vtype, sub_type=sub_type)
+
+    for t, keep_list in plan:
+        shape = list(int(d) for d in t.shape)
+        nbytes = int(t.n_bytes)
+        if keep_list is not None:
+            shape[-1] = keep
+            nbytes = nbytes * keep // n_expert
+        # writer expects the shape reversed relative to the reader's ne order
+        writer.add_tensor_info(t.name, list(reversed(shape)), np.uint8, nbytes,
+                               raw_dtype=t.tensor_type)
+
+    writer.write_header_to_file()
+    writer.write_kv_data_to_file()
+    writer.write_ti_data_to_file()
+
+    for t, keep_list in plan:
+        data = t.data.reshape(-1).view(np.uint8)
+        if keep_list is None:
+            writer.write_tensor_data(data)
+        else:
+            per_expert = data.nbytes // n_expert
+            assert data.nbytes % n_expert == 0, t.name
+            out = np.concatenate([data[e*per_expert:(e+1)*per_expert] for e in keep_list])
+            writer.write_tensor_data(out)
+        print(f"  wrote {t.name}")
+
+    writer.close()
+    print(f"done: {args.dst}")
+
+
+if __name__ == "__main__":
+    main()
