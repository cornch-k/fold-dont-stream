+}
+
+#if defined(__APPLE__)
+// resolve an mmap'ed pointer back to its backing (fd, file offset) so cold
+// expert slices can be pulled in with pread instead of page faults: a fault
+// costs ~60 us per 16 KB page (trap + pagein + page-table insert), capping
+// effective cold reads near 2 GB/s, while parallel preads through the same
+// unified buffer cache measure 8+ GB/s and leave the pages warm for mmap.
+#include <libproc.h>
+
+struct moe_filemap { uintptr_t lo, hi; int fd; uint64_t file_off; };
+static struct {
+    struct moe_filemap m[16];
+    int n;
+    int fail;
+    pthread_mutex_t mu;
+} g_moe_fmap = { .mu = PTHREAD_MUTEX_INITIALIZER };
+
+static int ggml_moe_resolve_fd(const void * p, uint64_t * file_off) {
+    uintptr_t a = (uintptr_t) p;
+    pthread_mutex_lock(&g_moe_fmap.mu);
+    for (int i = 0; i < g_moe_fmap.n; ++i) {
+        if (a >= g_moe_fmap.m[i].lo && a < g_moe_fmap.m[i].hi) {
+            *file_off = g_moe_fmap.m[i].file_off + (a - g_moe_fmap.m[i].lo);
+            int fd = g_moe_fmap.m[i].fd;
+            pthread_mutex_unlock(&g_moe_fmap.mu);
+            return fd;
+        }
+    }
+    if (g_moe_fmap.fail > 4 || g_moe_fmap.n >= 16) {
+        pthread_mutex_unlock(&g_moe_fmap.mu);
+        return -1;
+    }
+    struct proc_regionwithpathinfo ri;
+    memset(&ri, 0, sizeof(ri));
+    int r = proc_pidinfo(getpid(), PROC_PIDREGIONPATHINFO, (uint64_t) a, &ri, sizeof(ri));
+    if (r < (int) sizeof(ri) || ri.prp_vip.vip_path[0] == '\0') {
+        g_moe_fmap.fail++;
+        pthread_mutex_unlock(&g_moe_fmap.mu);
+        return -1;
+    }
+    int fd = open(ri.prp_vip.vip_path, O_RDONLY);
+    if (fd < 0) {
+        g_moe_fmap.fail++;
+        pthread_mutex_unlock(&g_moe_fmap.mu);
+        return -1;
+    }
+    struct moe_filemap * m = &g_moe_fmap.m[g_moe_fmap.n++];
+    m->lo       = (uintptr_t) ri.prp_prinfo.pri_address;
+    m->hi       = m->lo + ri.prp_prinfo.pri_size;
+    m->fd       = fd;
+    m->file_off = ri.prp_prinfo.pri_offset;
+    fprintf(stderr, "moe-pread: mapped region %p +%llu MiB -> %s @+%llu\n",
+            (void *) m->lo, (unsigned long long)(ri.prp_prinfo.pri_size >> 20),
+            ri.prp_vip.vip_path, (unsigned long long) m->file_off);
+    *file_off = m->file_off + (a - m->lo);
+    pthread_mutex_unlock(&g_moe_fmap.mu);
+    return fd;
+}
+// GGML_MOE_PREAD=1: for generation batches, compute cold expert slices out of
+// a pread-filled scratch arena instead of the mmap. Faulting mmap pages costs
+// ~60 us per 16 KB page (pmap lock + TLB shootdowns across busy threads), so
+// a cold token pays ~0.7 s in fault overhead alone regardless of how the data
+// reaches RAM. preads into private buffers do no address-space work at all and
+// run at the drive's parallel bandwidth. Resident slices (mincore) keep using
+// their long-lived mmap pages. Bit-identical: the same file bytes are read.
+#define MOE_PREAD_MAX_JOBS 256
+
+static struct {
+    int      enabled;    // -1 unknown
+    char   * scratch;
+    size_t   scratch_sz;
+    int      njobs;
+    struct { char * dst; const char * srcp; size_t len; uint64_t off; int fd; } jobs[MOE_PREAD_MAX_JOBS];
+    uint64_t n_cold, n_warm;
+} g_moe_pread = { .enabled = -1 };
+
+static void ggml_moe_pread_dump(void) {
+    fprintf(stderr, "moe-pread: cold slices=%llu warm slices=%llu (%.1f%% warm)\n",
+            (unsigned long long) g_moe_pread.n_cold, (unsigned long long) g_moe_pread.n_warm,
+            g_moe_pread.n_cold + g_moe_pread.n_warm ?
+                100.0 * (double) g_moe_pread.n_warm / (double)(g_moe_pread.n_cold + g_moe_pread.n_warm) : 0.0);
+}
+
+static int ggml_moe_pread_enabled(void) {
+    if (g_moe_pread.enabled == -1) {
+        const char * e = getenv("GGML_MOE_PREAD");
+        g_moe_pread.enabled = e != NULL && e[0] != '0';
+        if (g_moe_pread.enabled) {
+            fprintf(stderr, "moe-pread: scratch read-through enabled\n");
+            atexit(ggml_moe_pread_dump);
+        }
+    }
+    return g_moe_pread.enabled;
+}
+
+// GGML_MOE_ACT_DUMP=<dir>: append f32 input rows of routed gate ops per layer
+// for offline activation-aware rank analysis (Stage 1 of the low-rank
+// residency track). gate and up share the same input space, so capturing the
+// gate rows covers both. Capped rows per tensor; prefill and decode both.
+#define MOE_ACTDUMP_MAX_FILES 128
+#define MOE_ACTDUMP_MAX_ROWS  4096
+struct moe_actdump_file { char name[96]; FILE * f; int rows; };
+static struct {
+    int enabled; // -1 unknown
+    const char * dir;
+    struct moe_actdump_file files[MOE_ACTDUMP_MAX_FILES];
+    int nfiles;
+} g_moe_actdump = { .enabled = -1 };
+
+static int ggml_moe_actdump_enabled(void) {
+    if (g_moe_actdump.enabled == -1) {
+        g_moe_actdump.dir = getenv("GGML_MOE_ACT_DUMP");
+        g_moe_actdump.enabled = g_moe_actdump.dir != NULL;
+        if (g_moe_actdump.enabled) {
+            fprintf(stderr, "moe-actdump: writing gate inputs to %s\n", g_moe_actdump.dir);
+        }
+    }
+    return g_moe_actdump.enabled;
+}
+
+static void ggml_moe_actdump_rows(const struct ggml_tensor * src0, const struct ggml_tensor * src1, int64_t n_tokens) {
+    if (strstr(src0->name, "ffn_gate_exps") == NULL || src1->ne[1] != 1) {
+        return;
+    }
+    struct moe_actdump_file * slot = NULL;
+    for (int i = 0; i < g_moe_actdump.nfiles; ++i) {
+        if (strncmp(g_moe_actdump.files[i].name, src0->name, sizeof(g_moe_actdump.files[i].name)) == 0) {
+            slot = &g_moe_actdump.files[i];
+            break;
+        }
+    }
+    if (slot == NULL) {
+        if (g_moe_actdump.nfiles >= MOE_ACTDUMP_MAX_FILES) {
+            return;
+        }
+        slot = &g_moe_actdump.files[g_moe_actdump.nfiles++];
+        snprintf(slot->name, sizeof(slot->name), "%s", src0->name);
+        char path[1024];
+        snprintf(path, sizeof(path), "%s/%s.f32", g_moe_actdump.dir, src0->name);
+        slot->f = fopen(path, "wb");
+        slot->rows = 0;
+    }
+    if (slot->f == NULL) {
+        return;
+    }
+    for (int64_t i = 0; i < n_tokens && slot->rows < MOE_ACTDUMP_MAX_ROWS; ++i) {
+        fwrite((const char *) src1->data + i*src1->nb[2], 1, (size_t) src1->ne[0]*sizeof(float), slot->f);
+        slot->rows++;
+    }
+    fflush(slot->f);
+}
+
+// mostly-resident slices stay on their mmap pages (their PTEs persist across
+// tokens); anything colder is redirected to scratch
+static int ggml_moe_slice_resident(const void * base, size_t len) {
+    static _Thread_local char vec[8192];
+    const size_t page = 16384;
+    uintptr_t a0 = (uintptr_t) base & ~(page - 1);
+    size_t npages = (((uintptr_t) base + len + page - 1) & ~(page - 1)) - a0;
+    npages /= page;
+    if (npages > sizeof(vec)) {
+        return 1; // slice too large to check; assume resident
+    }
+    if (mincore((void *) a0, npages * page, vec) != 0) {
+        return 1;
+    }
+    size_t res = 0;
+    for (size_t i = 0; i < npages; ++i) {
+        res += vec[i] & 1;
+    }
+    return res * 100 >= npages * 90;
+}
+#endif // __APPLE__
+
+#if !defined(_WIN32)
+static void ggml_moe_prefetch_madvise(const void * base, size_t len) {
+    const size_t page = 16384;
+    uintptr_t a0 = (uintptr_t) base & ~(page - 1);
+    uintptr_t a1 = ((uintptr_t) base + len + page - 1) & ~(page - 1);
+    posix_madvise((void *) a0, a1 - a0, POSIX_MADV_WILLNEED);
+}
+
+// GGML_MOE_PREFETCH_THREADS=N: force parallel page-in with a pool of touch
+// threads. madvise(WILLNEED) leaves read-ahead timing to kernel discretion,
+// which sustains only ~2 GB/s effective on Apple NVMe during decode; the same
+// drive delivers 8+ GB/s at expert-slice granularity once the queue depth is
+// >= 4 (measured). Workers fault the pages in by reading one byte per page;
+// compute threads that reach the data first simply fault as before, so the
+// result is bit-identical with the feature on or off.
+#define MOE_TOUCH_QUEUE_SZ 4096
+static struct {
+    int             nthreads;   // -1 unknown, 0 off
+    pthread_mutex_t mu;
+    pthread_cond_t  cv;
+    struct { const char * base; size_t len; } q[MOE_TOUCH_QUEUE_SZ];
+    unsigned        head, tail; // free-running; tail-head <= MOE_TOUCH_QUEUE_SZ
+} g_moe_touch = {
+    .nthreads = -1,
+    .mu = PTHREAD_MUTEX_INITIALIZER,
+    .cv = PTHREAD_COND_INITIALIZER,
+};
+
+static void * ggml_moe_touch_worker(void * arg) {
+    (void) arg;
+    volatile unsigned char sink = 0;
+    for (;;) {
+        pthread_mutex_lock(&g_moe_touch.mu);
+        while (g_moe_touch.head == g_moe_touch.tail) {
+            pthread_cond_wait(&g_moe_touch.cv, &g_moe_touch.mu);
+        }
+        unsigned idx = g_moe_touch.head % MOE_TOUCH_QUEUE_SZ;
+        const char * base = g_moe_touch.q[idx].base;
+        size_t       len  = g_moe_touch.q[idx].len;
+        g_moe_touch.head++;
+        pthread_mutex_unlock(&g_moe_touch.mu);
+
+        ggml_moe_prefetch_madvise(base, len);
+        for (size_t o = 0; o < len; o += 16384) {
+            sink += ((const volatile unsigned char *) base)[o];
+        }
+    }
+    return NULL;
+}
+
+static int ggml_moe_touch_threads(void) {
+    if (g_moe_touch.nthreads == -1) {
+        const char * e = getenv("GGML_MOE_PREFETCH_THREADS");
+        int n = e ? atoi(e) : 0;
+        if (n < 0)  n = 0;
+        if (n > 16) n = 16;
+        g_moe_touch.nthreads = n;
+        for (int i = 0; i < n; ++i) {
+            pthread_t t;
+            if (pthread_create(&t, NULL, ggml_moe_touch_worker, NULL) == 0) {
+                pthread_detach(t);
+            }
+        }
+        if (n > 0) {
+            fprintf(stderr, "moe-prefetch: %d touch threads\n", n);
+        }
+    }
+    return g_moe_touch.nthreads;
+}
+
+static void ggml_moe_prefetch_slice(const void * base, size_t len) {
+    if (ggml_moe_touch_threads() > 0) {
+        pthread_mutex_lock(&g_moe_touch.mu);
+        if (g_moe_touch.tail - g_moe_touch.head < MOE_TOUCH_QUEUE_SZ) {
+            unsigned idx = g_moe_touch.tail % MOE_TOUCH_QUEUE_SZ;
+            g_moe_touch.q[idx].base = (const char *) base;
+            g_moe_touch.q[idx].len  = len;
+            g_moe_touch.tail++;
+            pthread_cond_signal(&g_moe_touch.cv);
+            pthread_mutex_unlock(&g_moe_touch.mu);
+            return;
+        }
+        // queue full: fall through to a synchronous hint rather than dropping
+        pthread_mutex_unlock(&g_moe_touch.mu);
+    }
+    ggml_moe_prefetch_madvise(base, len);
+}
+
+// GGML_MOE_CACHE_MB=<budget>: an explicit RAM cache for routed-expert slices,
+// replacing reliance on the OS page cache. Slices are copied out of the mmap
+// by a background thread (driven by the lookahead predictor below and by the
+// experts each op actually uses), so the compute path never blocks on a fill:
+// a miss just reads through the mmap as before and the slice becomes resident
+// for the next token. Eviction is segmented LRU (blocks are promoted on their
+// second touch), which keeps the hot set resident when prefill or mispredicted
+// prefetches sweep through. Blocks referenced this token are never evicted.
+// GGML_MOE_CACHE_MLOCK=1 additionally wires the cache memory.
+#if !defined(_WIN32)
+
+#define MOE_CACHE_MAX_AS    1024
+#define MOE_CACHE_HASH_SZ   (1u << 16)
+#define MOE_CACHE_QUEUE_SZ  1024
+
+enum moe_cache_state {
+    MOE_CACHE_FILLING   = 0,
+    MOE_CACHE_PROBATION = 1,
+    MOE_CACHE_PROTECTED = 2,
+};
+
+struct moe_cache_block {
+    const void * base;   // expert tensor data pointer (identity)
+    int          expert;
+    int          state;
+    size_t       size;
+    void       * ptr;
+    uint64_t     pin_epoch;
+    struct moe_cache_block * prev;
+    struct moe_cache_block * next;
+    struct moe_cache_block * hnext;
+};
+
+static struct {
+    int             enabled;   // -1 unknown, 0 off, 1 on
+    int             mlock;
+    size_t          budget;
+    size_t          used;      // malloc'd buffer bytes (live + size-class free lists)
+    uint64_t        epoch;
+    uint64_t        hits, misses, drops;
+    pthread_mutex_t mu;
+    pthread_cond_t  cv;
+    struct moe_cache_block * hash[MOE_CACHE_HASH_SZ];
+    struct moe_cache_block * lru_head[3], * lru_tail[3]; // indexed by state
+    struct moe_cache_block * free_blocks;
+    struct { const void * base; int expert; size_t size; } queue[MOE_CACHE_QUEUE_SZ];
+    int             q_head, q_tail;
+    int             worker_up;
+} g_moe_cache = {
+    .enabled = -1,
+    .mu = PTHREAD_MUTEX_INITIALIZER,
+    .cv = PTHREAD_COND_INITIALIZER,
+};
+
+// buffers on a size-class free list store the next pointer in their first bytes
+static void * g_moe_cache_free_bufs = NULL; // head of a (ptr,size,next) list
+struct moe_cache_free_buf { size_t size; void * next; };
+
+static uint32_t ggml_moe_cache_hash(const void * base, int expert) {
+    uint64_t h = (uint64_t)(uintptr_t) base;
+    h ^= (uint64_t)(uint32_t) expert * 0x9E3779B97F4A7C15ull;
+    h ^= h >> 29; h *= 0xBF58476D1CE4E5B9ull; h ^= h >> 32;
+    return (uint32_t) h & (MOE_CACHE_HASH_SZ - 1);
+}
+
+static void ggml_moe_cache_dump(void) {
+    fprintf(stderr, "moe-cache: hits=%llu misses=%llu (%.1f%% hit) queue-drops=%llu used=%.0f MiB\n",
+            (unsigned long long) g_moe_cache.hits, (unsigned long long) g_moe_cache.misses,
+            g_moe_cache.hits + g_moe_cache.misses ?
+                100.0 * (double) g_moe_cache.hits / (double)(g_moe_cache.hits + g_moe_cache.misses) : 0.0,
+            (unsigned long long) g_moe_cache.drops, (double) g_moe_cache.used / 1048576.0);
+}
+
+static int ggml_moe_cache_enabled(void) {
+    if (g_moe_cache.enabled == -1) {
+        const char * e = getenv("GGML_MOE_CACHE_MB");
+        long mb = e ? atol(e) : 0;
+        g_moe_cache.enabled = mb > 0;
+        g_moe_cache.budget  = (size_t) (mb > 0 ? mb : 0) * 1048576u;
+        g_moe_cache.mlock   = getenv("GGML_MOE_CACHE_MLOCK") != NULL;
+        if (g_moe_cache.enabled) {
+            fprintf(stderr, "moe-cache: enabled, budget=%ld MiB, mlock=%d\n", mb, g_moe_cache.mlock);
+            atexit(ggml_moe_cache_dump);
+        }
+    }
+    return g_moe_cache.enabled;
+}
+
+// list helpers, all called with the mutex held
+static void ggml_moe_cache_list_del(struct moe_cache_block * b) {
+    if (b->prev) { b->prev->next = b->next; } else { g_moe_cache.lru_head[b->state] = b->next; }
+    if (b->next) { b->next->prev = b->prev; } else { g_moe_cache.lru_tail[b->state] = b->prev; }
+    b->prev = b->next = NULL;
+}
+
+static void ggml_moe_cache_list_push(struct moe_cache_block * b, int state) {
+    b->state = state;
+    b->prev  = NULL;
+    b->next  = g_moe_cache.lru_head[state];
+    if (b->next) { b->next->prev = b; } else { g_moe_cache.lru_tail[state] = b; }
+    g_moe_cache.lru_head[state] = b;
+}
+
+static struct moe_cache_block * ggml_moe_cache_lookup(const void * base, int expert) {
+    struct moe_cache_block * b = g_moe_cache.hash[ggml_moe_cache_hash(base, expert)];
+    while (b && (b->base != base || b->expert != expert)) {
+        b = b->hnext;
+    }
+    return b;
+}
+
+static void ggml_moe_cache_hash_del(struct moe_cache_block * b) {
+    struct moe_cache_block ** p = &g_moe_cache.hash[ggml_moe_cache_hash(b->base, b->expert)];
+    while (*p != b) {
+        p = &(*p)->hnext;
+    }
+    *p = b->hnext;
+}
+
+// take a data buffer of exactly `size`: free list -> budget malloc -> evict
+static void * ggml_moe_cache_take_buf(size_t size) {
+    struct moe_cache_free_buf ** p = (struct moe_cache_free_buf **) &g_moe_cache_free_bufs;
+    while (*p) {
+        if ((*p)->size == size) {
+            void * buf = *p;
+            *p = (*p)->next;
+            return buf;
+        }
+        p = (struct moe_cache_free_buf **) &(*p)->next;
+    }
+    while (g_moe_cache.used + size > g_moe_cache.budget) {
