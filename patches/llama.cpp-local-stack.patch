+#!/usr/bin/env bash
+# Strategy matrix driver. GUARDED: does nothing unless RUN=1 is set, so it can be
+# read/edited freely without ever launching the model by accident.
+#
+#   RUN=1 ./matrix.sh            # run the whole matrix
+#   RUN=1 ONLY=A ./matrix.sh     # run a single row by label prefix
+#
+# Each row is: label residency warmup ncmoe kvk kvv
+# Edit the rows below to change scope. Cold-cache runs: to measure a true cold
+# start, purge the page cache before a row (needs sudo): sudo purge.
+
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+. "${HERE}/common.sh"
+
+if [ "${RUN:-0}" != "1" ]; then
+    cat <<EOF
+matrix.sh is guarded. It will NOT run the model unless RUN=1.
+Planned rows (label : residency warmup ncmoe kv):
+  A_noresid_nowarm     : off on->no  0   f16/f16   (Strategy A: Metal, unwired, lazy)
+  A_kvq8               : off no       0   q8_0/q8_0 (Strategy A + quantized KV)
+  B_ncmoe49            : on  no       49  f16/f16   (Strategy B: all experts on CPU)
+  B_ncmoe24            : on  no       24  f16/f16   (Strategy B: hybrid split)
+  B_ncmoe12            : on  no       12  f16/f16   (Strategy B: mostly GPU)
+  Z_baseline_default   : on  yes      0   f16/f16   (naive default; expected to swap)
+
+To run:   RUN=1 ${0}
+EOF
+    exit 0
+fi
+
+harness_preflight || { echo "preflight failed" >&2; exit 1; }
+sysinfo_dump
+
+# label residency warmup ncmoe kvk kvv
+ROWS=(
+  "A_noresid_nowarm   off off 0  f16  f16"
+  "A_kvq8             off off 0  q8_0 q8_0"
+  "B_ncmoe49          on  off 49 f16  f16"
+  "B_ncmoe24          on  off 24 f16  f16"
+  "B_ncmoe12          on  off 12 f16  f16"
+  "Z_baseline_default on  on  0  f16  f16"
+)
+
+for row in "${ROWS[@]}"; do
+    set -- ${row}
+    label="$1"
+    if [ -n "${ONLY:-}" ] && [ "${label#${ONLY}}" = "${label}" ]; then
+        continue
+    fi
+    "${HERE}/run_one.sh" "$1" "$2" "$3" "$4" "$5" "$6"
+done
+
+echo "=== matrix complete. summary: ${RESULTS}/summary.tsv ==="
+column -t -s"$(printf '\t')" "${RESULTS}/summary.tsv" 2>/dev/null || cat "${RESULTS}/summary.tsv"
diff --git a/scripts/m1max-moe/monitor.sh b/scripts/m1max-moe/monitor.sh
new file mode 100755
index 000000000..1b96c8558
--- /dev/null
+++ b/scripts/m1max-moe/monitor.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# Background memory/paging sampler. Samples system paging state and one process's
+# RSS every INTERVAL seconds until that process exits.
+#
+# usage: monitor.sh <pid> <out.csv> [interval_s]
+#
+# Columns: t_s, rss_mb, wired_mb, compressed_mb, free_mb, swap_used_mb, pageins, swapins
+# System pages come from vm_stat; swap from vm.swapusage. wired/compressed capture
+# the Metal residency-set effect that per-process RSS alone can miss.
+
+set -u
+
+pid="${1:?pid required}"
+out="${2:?out csv required}"
+interval="${3:-0.5}"
+
+pgsize="$(sysctl -n hw.pagesize 2>/dev/null || echo 16384)"
+
+echo "t_s,rss_mb,wired_mb,compressed_mb,free_mb,swap_used_mb,pageins,swapins" > "${out}"
+
+start="$(date +%s)"
+while kill -0 "${pid}" 2>/dev/null; do
+    now="$(date +%s)"
+    t=$(( now - start ))
+
+    rss_kb="$(ps -o rss= -p "${pid}" 2>/dev/null | tr -d ' ')"
+    [ -n "${rss_kb}" ] || rss_kb=0
+    rss_mb=$(( rss_kb / 1024 ))
+
+    # vm_stat: pull page counts, convert to MB
+    vs="$(vm_stat 2>/dev/null)"
+    getpages() { echo "${vs}" | awk -F: "/$1/ {gsub(/[ .]/,\"\",\$2); print \$2}"; }
+    wired_p="$(getpages 'Pages wired down')";        wired_p="${wired_p:-0}"
+    comp_p="$(getpages 'occupied by compressor')";   comp_p="${comp_p:-0}"
+    free_p="$(getpages 'Pages free')";               free_p="${free_p:-0}"
+    pageins="$(getpages 'Pageins')";                 pageins="${pageins:-0}"
+    swapins="$(getpages 'Swapins')";                 swapins="${swapins:-0}"
+
+    wired_mb=$(( wired_p * pgsize / 1048576 ))
+    comp_mb=$(( comp_p * pgsize / 1048576 ))
+    free_mb=$(( free_p * pgsize / 1048576 ))
+
+    swap_mb="$(sysctl -n vm.swapusage 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="used"){v=$(i+2); gsub(/[A-Za-z]/,"",v); print int(v)}}')"
+    [ -n "${swap_mb}" ] || swap_mb=0
+
+    echo "${t},${rss_mb},${wired_mb},${comp_mb},${free_mb},${swap_mb},${pageins},${swapins}" >> "${out}"
+    sleep "${interval}"
+done
diff --git a/scripts/m1max-moe/pin_ranges.c b/scripts/m1max-moe/pin_ranges.c
new file mode 100644
index 000000000..27035ca8b
--- /dev/null
+++ b/scripts/m1max-moe/pin_ranges.c
@@ -0,0 +1,63 @@
+// Pin byte ranges of a file into the page cache with mmap+mlock and stay
+// resident. File-backed pages locked here are the same physical pages another
+// process (llama-cli) sees through its own mapping of the file, so this
+// protects hot experts from cache eviction without touching llama.cpp.
+//
+//   cc -O2 -o pin_ranges pin_ranges.c
+//   ./pin_ranges <file> <ranges.txt>   # lines: "<offset> <length>", '#' = comment
+//
+// mlock failures (wire limit) are counted, not fatal; locking continues with
+// the remaining ranges so the hottest prefix still gets pinned.
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+int main(int argc, char ** argv) {
+    if (argc != 3) {
+        fprintf(stderr, "usage: %s <file> <ranges.txt>\n", argv[0]);
+        return 1;
+    }
+    int fd = open(argv[1], O_RDONLY);
+    if (fd < 0) { perror("open file"); return 1; }
+    struct stat st;
+    if (fstat(fd, &st) != 0) { perror("fstat"); return 1; }
+    unsigned char * base = mmap(NULL, (size_t) st.st_size, PROT_READ, MAP_SHARED, fd, 0);
+    if (base == MAP_FAILED) { perror("mmap"); return 1; }
+
+    FILE * f = fopen(argv[2], "r");
+    if (f == NULL) { perror("open ranges"); return 1; }
+
+    const long page = sysconf(_SC_PAGESIZE);
+    size_t locked = 0, failed = 0;
+    char line[256];
+    while (fgets(line, sizeof(line), f)) {
+        if (line[0] == '#' || line[0] == '\n') {
+            continue;
+        }
+        unsigned long long off, len;
+        if (sscanf(line, "%llu %llu", &off, &len) != 2) {
+            continue;
+        }
+        if (off + len > (unsigned long long) st.st_size) {
+            fprintf(stderr, "skip out-of-file range %llu+%llu\n", off, len);
+            continue;
+        }
+        unsigned long long a0 = off & ~(unsigned long long)(page - 1);
+        unsigned long long a1 = (off + len + page - 1) & ~(unsigned long long)(page - 1);
+        if (mlock(base + a0, a1 - a0) == 0) {
+            locked += a1 - a0;
+        } else {
+            failed += a1 - a0;
+        }
+    }
+    fclose(f);
+    fprintf(stderr, "pinned %.0f MiB, failed %.0f MiB; holding (ctrl-c to release)\n",
+            locked / 1048576.0, failed / 1048576.0);
+    pause();
+    return 0;
+}
