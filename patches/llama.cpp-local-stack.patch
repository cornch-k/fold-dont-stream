diff --git a/scripts/m1max-moe/run_one.sh b/scripts/m1max-moe/run_one.sh
new file mode 100755
index 000000000..a6dc7c380
--- /dev/null
+++ b/scripts/m1max-moe/run_one.sh
@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+# Run ONE llama-cli configuration, monitored, and append a metrics row.
+#
+# usage: run_one.sh <label> <residency:on|off> <warmup:on|off> <ncmoe:N> <kvk> <kvv>
+#
+# Peak RSS / peak wired / swap growth come from monitor.sh (sampled), throughput
+# and load time from llama.cpp's own perf print. A watchdog kills a run that
+# exceeds MAX_SECONDS (a thrashing config must not hang the matrix).
+
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+. "${HERE}/common.sh"
+
+label="${1:?label}"; residency="${2:?on|off}"; warmup="${3:?on|off}"
+ncmoe="${4:?N}"; kvk="${5:-$KV_K}"; kvv="${6:-$KV_V}"
+MAX_SECONDS="${MAX_SECONDS:-1200}"
+
+stamp="$(date '+%Y%m%d-%H%M%S')"
+raw="${RESULTS}/${label}.${stamp}.log"
+mon="${RESULTS}/${label}.${stamp}.mon.csv"
+summary="${RESULTS}/summary.tsv"
+
+# environment: residency escape hatch
+env_pfx=()
+[ "${residency}" = "off" ] && env_pfx=(env GGML_METAL_NO_RESIDENCY=1)
+
+# llama-cli argument vector
+args=( -m "${MODEL}" -c "${CTX}" -n "${NGEN}" -t "${THREADS}"
+       -fa "${FA}" -ctk "${kvk}" -ctv "${kvv}" -ngl 999
+       -no-cnv --seed 42 -mmp 1 -p "${PROMPT}" )
